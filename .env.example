# Copy this file to .env for local development.
# Do not commit real secrets or customer-specific configuration.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible clients can use DeepSeek with these values.
OPENAI_API_KEY=${DEEPSEEK_API_KEY}
OPENAI_BASE_URL=${DEEPSEEK_BASE_URL}
OPENAI_MODEL=${DEEPSEEK_MODEL}

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

APP_ENV=local
APP_BASE_URL=http://localhost:3000

DATABASE_URL=
OBJECT_STORAGE_URL=
VECTOR_STORE_URL=

EVALUATION_SERVICE_URL=http://localhost:4000
AUDIT_LOG_DESTINATION=local
