# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Runtime data
data/
uploads/
runtime/*
outputs/*
logs/*
tmp/
input/

# OUTPUT/ — 工作内容产出（业务文档、分析报告等），需要Git跟踪
# 使用 ! 否定模式取消忽略，确保业务产出可追溯
/output/
!/OUTPUT/

# Phase 7c-e: 候选变更 & 仪表盘（显式排除，不走 Git）
runtime/candidate_changes/
outputs/dashboard/
outputs/eval_reports/regression/

# Lattice 框架运行态数据（不走 Git）
lattice/lattice_runtime/

# 新建项目（不走 Git）
company-management/

# Customer or business content
customer_docs/
client_files/
workspaces/*/documents/
workspaces/*/outputs/
workspaces/*/logs/

# Vector, index, and cache data
vector_store/
indexes/
embeddings/
.cache/

# Raw feedback and traces
feedback/raw/
traces/

# Local OS and editor noise
.DS_Store
Thumbs.db
.idea/
# VS Code: ignore personal state, version shared workspace config
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/mcp.json
*.code-workspace

# Dependency and build outputs
node_modules/
dist/
build/
coverage/
__pycache__/
*.pyc
