{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/run_snapshot.schema.json",
  "title": "Run Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "workflow_id",
    "workflow_version",
    "workflow_state",
    "versions",
    "context_intent_gate",
    "context_load_plan",
    "input_summary",
    "retrieved_sources",
    "output_summary",
    "constraints_triggered",
    "tool_calls",
    "human_review",
    "interruptions",
    "resume_events",
    "created_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1
    },
    "workflow_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "current_node"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "created",
            "context_intent_pending",
            "context_intent_confirmed",
            "running",
            "workflow_pause",
            "interrupted_by_user",
            "cancelled_by_user",
            "completed",
            "failed"
          ]
        },
        "current_node": {
          "type": "string"
        },
        "checkpoint_id": {
          "type": "string"
        },
        "resume_node": {
          "type": "string"
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_version",
        "constraint_pack_version",
        "knowledge_base_version",
        "model_version"
      ],
      "properties": {
        "prompt_version": {
          "type": "string"
        },
        "constraint_pack_version": {
          "type": "string"
        },
        "knowledge_base_version": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "evaluator_version": {
          "type": "string"
        },
        "git_commit": {
          "type": "string"
        }
      }
    },
    "context_intent_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "intent_summary",
        "workflow_selected",
        "risk_level",
        "missing_information",
        "allowed_scope",
        "approval_required"
      ],
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "intent_summary": {
          "type": "string"
        },
        "workflow_selected": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_required": {
          "type": "boolean"
        }
      }
    },
    "context_load_plan": {
      "$ref": "context_load_plan.schema.json"
    },
    "input_summary": {
      "type": "object",
      "description": "A minimized or redacted summary of user input.",
      "additionalProperties": true
    },
    "retrieved_sources": {
      "type": "array",
      "items": {
        "$ref": "citation.schema.json"
      }
    },
    "output_summary": {
      "type": "object",
      "description": "A minimized or redacted summary of the model output.",
      "additionalProperties": true
    },
    "constraints_triggered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint_id",
          "severity",
          "action"
        ],
        "properties": {
          "constraint_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "action": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_name",
          "status"
        ],
        "properties": {
          "tool_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "approved",
              "completed",
              "failed",
              "blocked"
            ]
          },
          "input_summary": {
            "type": "object",
            "additionalProperties": true
          },
          "output_summary": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected",
            "modified"
          ]
        },
        "reviewer_role": {
          "type": "string"
        },
        "notes_summary": {
          "type": "string"
        }
      }
    },
    "interruptions": {
      "type": "array",
      "items": {
        "$ref": "interruption_event.schema.json"
      }
    },
    "resume_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resume_event_id",
          "interruption_id",
          "validation_result",
          "created_at"
        ],
        "properties": {
          "resume_event_id": {
            "type": "string"
          },
          "interruption_id": {
            "type": "string"
          },
          "user_supplement_summary": {
            "type": "string"
          },
          "structured_patch": {
            "type": "object",
            "additionalProperties": true
          },
          "validation_result": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected",
              "requires_more_information"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "user_feedback": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
